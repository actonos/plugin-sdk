{
  "id": "connector-google-workspace",
  "name": "Google Workspace Connector",
  "version": "1.0.0",
  "description": "Google Workspace integration for ActonOS AI agents (Gmail, Google Calendar, Google Drive, Google Docs)",
  "author": "ActonOS Core Team",
  "license": "MIT",
  "capabilities": ["connector", "tool"],
  "permissions": {
    "net_outbound": ["gmail.googleapis.com", "www.googleapis.com"],
    "secrets": ["google_workspace_access_token"],
    "storage": false,
    "bus_events": ["connector.google.email_sent", "connector.google.event_created"]
  },
  "connectors": [
    {
      "name": "google-workspace",
      "display_name": "Google Workspace",
      "auth_type": "oauth2",
      "actions": ["send_email", "create_calendar_event", "list_drive_files", "get_doc_content"]
    }
  ],
  "config_schema": {
    "type": "object",
    "required": ["google_workspace_access_token"],
    "properties": {
      "google_workspace_access_token": {
        "type": "string",
        "title": "Google OAuth2 Access Token",
        "description": "OAuth2 Token with Gmail, Calendar, Drive, and Docs API scopes",
        "x-secret": true,
        "x-ui-widget": "password",
        "x-ui-placeholder": "ya29..."
      }
    }
  },
  "tools": [
    {
      "name": "connector_google-workspace_send_email",
      "description": "Send an email via Gmail API",
      "category": "google",
      "schema": {
        "type": "object",
        "required": ["to", "subject", "body"],
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient email address"
          },
          "subject": {
            "type": "string",
            "description": "Email subject line"
          },
          "body": {
            "type": "string",
            "description": "Email body content in plain text or HTML"
          }
        }
      }
    },
    {
      "name": "connector_google-workspace_create_calendar_event",
      "description": "Schedule a meeting or calendar event via Google Calendar API",
      "category": "google",
      "schema": {
        "type": "object",
        "required": ["summary", "start_time", "end_time"],
        "properties": {
          "summary": {
            "type": "string",
            "description": "Event title or meeting summary"
          },
          "description": {
            "type": "string",
            "description": "Event details or meeting agenda"
          },
          "start_time": {
            "type": "string",
            "description": "Event start in ISO8601 format (e.g. 2026-08-25T10:00:00Z)"
          },
          "end_time": {
            "type": "string",
            "description": "Event end in ISO8601 format (e.g. 2026-08-25T11:00:00Z)"
          }
        }
      }
    },
    {
      "name": "connector_google-workspace_list_drive_files",
      "description": "Search and list files on Google Drive",
      "category": "google",
      "schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Google Drive search query (e.g. name contains 'Contract')"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum files to return (default 10)"
          }
        }
      }
    },
    {
      "name": "connector_google-workspace_get_doc_content",
      "description": "Retrieve document text content from Google Docs",
      "category": "google",
      "schema": {
        "type": "object",
        "required": ["document_id"],
        "properties": {
          "document_id": {
            "type": "string",
            "description": "Google Docs file / document ID"
          }
        }
      }
    }
  ]
}

{
  "id": "connector-linear",
  "name": "Linear Connector",
  "version": "1.0.0",
  "description": "Linear project management integration for ActonOS AI agents (Issues, Projects, Teams)",
  "author": "ActonOS Core Team",
  "license": "MIT",
  "capabilities": ["connector", "tool"],
  "permissions": {
    "net_outbound": ["api.linear.app"],
    "secrets": ["linear_api_key"],
    "storage": false,
    "bus_events": ["connector.linear.issue_created", "connector.linear.issue_updated"]
  },
  "connectors": [
    {
      "name": "linear",
      "display_name": "Linear",
      "auth_type": "api_key",
      "actions": ["list_issues", "create_issue", "update_issue_status"]
    }
  ],
  "config_schema": {
    "type": "object",
    "required": ["linear_api_key"],
    "properties": {
      "linear_api_key": {
        "type": "string",
        "title": "Linear API Key",
        "description": "Personal API Key generated from Linear Settings > Account > Security",
        "x-secret": true,
        "x-ui-widget": "password",
        "x-ui-placeholder": "lin_api_..."
      }
    }
  },
  "tools": [
    {
      "name": "connector_linear_list_issues",
      "description": "List issues from Linear workspace",
      "category": "linear",
      "parameters": {
        "type": "object",
        "properties": {
          "team_key": {
            "type": "string",
            "description": "Linear Team key (e.g. ENG, ACT)"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum issues to return (default 10)"
          }
        }
      }
    },
    {
      "name": "connector_linear_create_issue",
      "description": "Create a new issue/task in Linear",
      "category": "linear",
      "parameters": {
        "type": "object",
        "required": ["team_id", "title"],
        "properties": {
          "team_id": {
            "type": "string",
            "description": "Linear Team ID (UUID or key)"
          },
          "title": {
            "type": "string",
            "description": "Issue title"
          },
          "description": {
            "type": "string",
            "description": "Issue description / markdown body"
          },
          "priority": {
            "type": "integer",
            "description": "Priority (0=No priority, 1=Urgent, 2=High, 3=Medium, 4=Low)"
          }
        }
      }
    },
    {
      "name": "connector_linear_update_issue_status",
      "description": "Update the state or status of a Linear issue",
      "category": "linear",
      "parameters": {
        "type": "object",
        "required": ["issue_id", "state_id"],
        "properties": {
          "issue_id": {
            "type": "string",
            "description": "Linear issue ID (UUID)"
          },
          "state_id": {
            "type": "string",
            "description": "Target workflow state ID"
          }
        }
      }
    }
  ]
}

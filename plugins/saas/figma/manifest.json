{
  "id": "connector-figma",
  "name": "Figma Connector",
  "version": "1.0.0",
  "description": "Figma design integration for ActonOS AI agents (Design Files, Components, Design Comments)",
  "author": "ActonOS Core Team",
  "license": "MIT",
  "capabilities": ["connector", "tool"],
  "permissions": {
    "net_outbound": ["api.figma.com"],
    "secrets": ["figma_access_token"],
    "storage": false,
    "bus_events": ["connector.figma.comment_posted"]
  },
  "connectors": [
    {
      "name": "figma",
      "display_name": "Figma",
      "auth_type": "oauth2",
      "actions": ["get_file", "get_comments", "post_comment"]
    }
  ],
  "config_schema": {
    "type": "object",
    "required": ["figma_access_token"],
    "properties": {
      "figma_access_token": {
        "type": "string",
        "title": "Figma Personal Access Token",
        "description": "Personal Access Token generated from Figma Account Settings",
        "x-secret": true,
        "x-ui-widget": "password",
        "x-ui-placeholder": "figd_..."
      }
    }
  },
  "tools": [
    {
      "name": "connector_figma_get_file",
      "description": "Retrieve Figma design file metadata and node tree",
      "category": "figma",
      "parameters": {
        "type": "object",
        "required": ["file_key"],
        "properties": {
          "file_key": {
            "type": "string",
            "description": "Figma file key (e.g. 7X3sD8... from URL)"
          },
          "depth": {
            "type": "integer",
            "description": "Tree traversal depth limit (default 2)"
          }
        }
      }
    },
    {
      "name": "connector_figma_get_comments",
      "description": "Get design comments and discussion threads from a Figma file",
      "category": "figma",
      "parameters": {
        "type": "object",
        "required": ["file_key"],
        "properties": {
          "file_key": {
            "type": "string",
            "description": "Figma file key"
          }
        }
      }
    },
    {
      "name": "connector_figma_post_comment",
      "description": "Post a design comment or feedback on a Figma file",
      "category": "figma",
      "parameters": {
        "type": "object",
        "required": ["file_key", "message"],
        "properties": {
          "file_key": {
            "type": "string",
            "description": "Figma file key"
          },
          "message": {
            "type": "string",
            "description": "Comment message content"
          },
          "x": {
            "type": "number",
            "description": "X coordinate pin on canvas"
          },
          "y": {
            "type": "number",
            "description": "Y coordinate pin on canvas"
          }
        }
      }
    }
  ]
}

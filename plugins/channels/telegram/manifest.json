{
  "id": "channel-telegram",
  "name": "Telegram Bot Channel",
  "version": "1.0.0",
  "description": "Telegram Bot integration for ActonOS AI agents with MarkdownV2, inline buttons, and multi-agent routing",
  "author": "ActonOS Core Team",
  "license": "MIT",
  "capabilities": ["channel"],
  "permissions": {
    "net_outbound": ["api.telegram.org"],
    "secrets": ["telegram_bot_token"],
    "storage": true,
    "bus_events": ["channel.telegram.received", "channel.telegram.sent"]
  },
  "channels": [
    {
      "name": "telegram",
      "display_name": "Telegram Bot",
      "requires_pairing": true
    }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "poll_interval_sec": {
        "type": "integer",
        "description": "Long polling interval in seconds",
        "default": 30
      }
    }
  }
}
